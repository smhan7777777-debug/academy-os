# Academy OS — 환경변수 템플릿. 복사해서 .env 로 쓴다 (.env 는 커밋하지 않는다).
# DB: 지금은 로컬 SQLite. Supabase 는 오너가 프로젝트 `academy-os` 를 만들고 키를 준 뒤에만 붙인다.
# 다른 앱(sermon/worship/petcare)의 Supabase ref·키는 절대 여기 넣지 않는다 — 루트 DATABASE.md 참조.
SUPABASE_URL=https://<academy-os-project-ref>.supabase.co
SUPABASE_ANON_KEY=
# 서버(server/) 전용. 브라우저 번들·Vite 변수(VITE_*)로 내보내지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 수업 스튜디오의 공개 수업 체험 AI 초안. 둘 다 설정해야 활성화됩니다.
# 키는 서버 전용입니다. 사용 가능한 모델 ID를 입력하세요. 미설정 시 직접 작성·예시 사용 가능.
ACADEMY_GEMINI_KEY=
ACADEMY_GEMINI_MODEL=
