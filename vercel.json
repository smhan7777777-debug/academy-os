{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,public/templates/**,public/site-library.*}",
      "excludeFiles": "{.env,.env.*,agent1000-academy-lab/**,docs/**,tests/**,test-results/**,scripts/**,public/videos/**,public/designs/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/site/:path*", "destination": "/api/index" },
    { "source": "/site", "destination": "/api/index" },
    { "source": "/start", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/agents", "destination": "/index.html" },
    { "source": "/learn", "destination": "/index.html" },
    { "source": "/welcome", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/Academy-OS-Business-Brief-2026-09.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=Academy-OS-Business-Brief-2026-09.pdf"
        }
      ]
    }
  ]
}
